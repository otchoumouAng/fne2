  <property name="styleSheet">
   <string notr="true">
/* --- FENÊTRE PRINCIPALE --- */
QDialog {
    background-color: #FFFFFF;
}

/* --- ZONE DE GAUCHE (BRANDING) --- */
#LeftBox {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #4e54c8, stop:1 #8f94fb);
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}

#BrandTitle {
    color: #FFFFFF;
    font-family: 'Segoe UI', sans-serif;
    font-size: 32px;
    font-weight: bold;
}

#BrandSubtitle {
    color: #E0E0E0;
    font-family: 'Segoe UI', sans-serif;
    font-size: 14px;
}

/* --- ZONE DE DROITE (FORMULAIRE) --- */
#RightBox {
    background-color: #FFFFFF;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

/* --- TITRES DROITE --- */
#LoginTitle {
    color: #333333;
    font-family: 'Segoe UI', sans-serif;
    font-size: 24px;
    font-weight: bold;
}
#LoginSubtitle {
    color: #999999;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
}

/* --- CHAMPS DE SAISIE --- */
QLineEdit {
    border: none;
    border-bottom: 2px solid #E0E0E0;
    padding: 10px 5px;
    background-color: transparent;
    font-size: 14px;
    color: #333333;
}

QLineEdit:focus {
    border-bottom: 2px solid #4e54c8;
}

/* --- BOUTON PRINCIPAL --- */
QPushButton#login_btn {
    background-color: #4e54c8;
    color: white;
    border-radius: 20px; /* Bouton pillule */
    padding: 12px;
    font-size: 14px;
    font-weight: bold;
    border: none;
}
QPushButton#login_btn:hover {
    background-color: #3f44a5;
}
QPushButton#login_btn:pressed {
    background-color: #303380;
}

/* --- LIEN OUBLIÉ --- */
QLabel#forgot_lbl {
    color: #888888;
    font-size: 12px;
}
QLabel#forgot_lbl:hover {
    color: #4e54c8;
    text-decoration: underline;
}

/* --- BOUTON FERMER CUSTOM --- */
QPushButton#close_btn {
    background-color: transparent;
    color: #AAAAAA;
    font-weight: bold;
    border: none;
    font-size: 16px;
}
QPushButton#close_btn:hover {
    color: #FF5555;
}
</string>
