     <property name="styleSheet">
      <string notr="true">
/* --- FENÊTRE PRINCIPALE --- */
QDialog {
    background-color: #FFFFFF;
}

QWidget#LoginContainer{
border-radius:10px;
border: 6px solid rgba(78, 84, 200,0.3);
}

/* --- ZONE DE GAUCHE (BRANDING) --- */
#LeftBox {
  
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}


#BrandTitle {
    color: rgb(78, 84, 200);
    font-family: 'Segoe UI', sans-serif;
    font-size: 32px;
    font-weight: bold;
}

#BrandSubtitle {
    color:  rgb(78, 84, 200);
    font-family: 'Segoe UI', sans-serif;
    font-size: 14px;
}

/* --- ZONE DE DROITE (FORMULAIRE) --- */
#RightBox {
    background-color: #FFFFFF;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

/* --- TITRES DROITE --- */
#LoginTitle {
    color: #333333;
    font-family: 'Segoe UI', sans-serif;
    font-size: 24px;
    font-weight: bold;
}
#LoginSubtitle {
    color: #999999;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
}

/* --- CHAMPS DE SAISIE --- */
QLineEdit {
    border: none;
    border-bottom: 2px solid #E0E0E0;
    padding: 10px 5px;
    background-color: transparent;
    font-size: 14px;
    color: #333333;
}

QLineEdit:focus {
    border-bottom: 2px solid #4e54c8;
}

/* --- BOUTON PRINCIPAL --- */
QPushButton#login_btn {
    background-color: #4e54c8;
    color: white;
    border-radius: 20px; /* Bouton pillule */
    padding: 12px;
    font-size: 14px;
    font-weight: bold;
    border: none;
}
QPushButton#login_btn:hover {
    background-color: #3f44a5;
}
QPushButton#login_btn:pressed {
    background-color: #303380;
}

/* --- LIEN OUBLIÉ --- */
QLabel#forgot_lbl {
    color: #888888;
    font-size: 12px;
}
QLabel#forgot_lbl:hover {
    color: #4e54c8;
    text-decoration: underline;
}

/* --- BOUTON FERMER CUSTOM --- */
QPushButton#close_btn {
    background-color: transparent;
    color: #AAAAAA;
    font-weight: bold;
    border: none;
    font-size: 16px;
}
QPushButton#close_btn:hover {
    color: #FF5555;
}


QWidget#LoginContainer{
background-image: url(:/images/images/bg-login.png);
	border: 1px solid qlineargradient(spread:pad, x1:0.482, y1:0, x2:0.493, y2:1, stop:0 rgba(78, 84, 200, 255), stop:1 rgba(84, 90, 205, 255));
}

</string>
